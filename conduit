#!/usr/bin/env bash
# conduit — relay your laptop's files, read-only, into cloud VMs and sandboxes.
#
#   conduit up user@vm                      # ~ appears on the VM at the same path, read-only
#   conduit up user@vm --writable           # sandbox may write; writes stay on the sandbox
#   conduit up user@vm --write-back-new     # …and files it *creates* are copied back
#   conduit up --exec 'docker exec -i box' --path ~/code
#
# How it works: the laptop runs OpenSSH's stock `sftp-server -R` (read-only)
# and pipes it through your ssh connection into `sshfs -o passive` on the
# sandbox. An overlay (kernel overlayfs, or fuse-overlayfs) sits on top for
# hiding credential folders and, with --writable, for sandbox-local writes.
# The sandbox can never modify the laptop: sftp-server refuses every write.
# --write-back-new is the laptop *pulling* newly created files, never
# overwriting a file that conduit didn't create itself.
#
# Runs on macOS's stock bash 3.2. Apache-2.0 licensed.

set -euo pipefail
VERSION=0.2.0

die()  { printf 'conduit: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[2mconduit:\033[0m %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
conduit — relay your laptop's files, read-only, into cloud VMs and sandboxes

Usage:
  conduit up     [TARGET] [options]   mount and keep the mirror alive (Ctrl-C to stop)
  conduit status [TARGET] [options]   show conduit mounts on the sandbox
  conduit diff   [TARGET] [options]   list files the sandbox added (A), modified (M), deleted (D)
  conduit pull   [TARGET] [options]   copy sandbox-side changes into a review folder
  conduit down   [TARGET] [options]   unmount on the sandbox

TARGET is anything `ssh` accepts (user@host, a Host alias from ~/.ssh/config).

Options:
  --path DIR         laptop folder to share (default: $HOME)
  --mount-at DIR     where it appears on the sandbox (default: same path as --path)
  --writable         let the sandbox create/edit/delete files in the mirror; changes
                     stay on the sandbox (copy-on-write), the laptop is untouched
  --write-back-new   (implies --writable) copy files the sandbox *creates* back to
                     the laptop. Never overwrites existing laptop files, never
                     deletes, skips dot-paths, Library/ and symlinks
  --exec 'CMD'       transport other than ssh; CMD runs a program on the sandbox
                     with stdin/stdout attached, e.g.
                       --exec 'docker exec -i mybox'
                       --exec 'kubectl exec -i mypod --'
  -o OPT             extra ssh option (repeatable), e.g. -o Port=2222
  --hide REL         hide REL (relative to --path) on the sandbox; repeatable
  --no-default-hide  don't hide the built-in list of credential folders
  --dest DIR         (pull) review folder (default: ./conduit-pull)
  -h, --help         this help

Environment:
  CONDUIT_SYNC_INTERVAL  seconds between write-back checks (default 5)
  CONDUIT_TMPFS_SIZE     cap for the RAM-backed writable layer, when used (default 4g)
EOF
}

# Credential-ish folders hidden by default. This keeps agents in the sandbox
# from stumbling into them; it is NOT a security boundary (root on the sandbox
# can read the raw lower mount). --path is the real boundary.
DEFAULT_HIDE=(.ssh .aws .gnupg .kube .docker .netrc .git-credentials .npmrc .pypirc
  .config/gcloud .config/gh .azure Library/Keychains Library/Cookies
  "Library/Application Support/Google/Chrome" "Library/Application Support/Firefox"
  Library/Messages Library/Mail)

# ---------------------------------------------------------------- arguments
CMD=${1:-}
case "$CMD" in
  up|status|diff|pull|down) shift ;;
  -h|--help|help|"") usage; exit 0 ;;
  --version|version) echo "conduit $VERSION"; exit 0 ;;
  *) die "unknown command '$CMD' (try --help)" ;;
esac

TARGET="" EXEC="" SRC="$HOME" MNT="" MODE=ro WRITEBACK=0 DEST="./conduit-pull" USE_DEFAULT_HIDE=1
SSH_OPTS=() HIDE=()
while [ $# -gt 0 ]; do
  case "$1" in
    --path)      SRC=${2:?--path needs a value}; shift 2 ;;
    --mount-at)  MNT=${2:?--mount-at needs a value}; shift 2 ;;
    --writable)  MODE=writable; shift ;;
    --write-back-new) MODE=writable; WRITEBACK=1; shift ;;
    --exec)      EXEC=${2:?--exec needs a value}; shift 2 ;;
    -o)          SSH_OPTS+=(-o "${2:?-o needs a value}"); shift 2 ;;
    --hide)      HIDE+=("${2:?--hide needs a value}"); shift 2 ;;
    --no-default-hide) USE_DEFAULT_HIDE=0; shift ;;
    --dest)      DEST=${2:?--dest needs a value}; shift 2 ;;
    --rw)        die "--rw was removed: the laptop is never written by the sandbox. See --writable / --write-back-new" ;;
    -h|--help)   usage; exit 0 ;;
    -*)          die "unknown option '$1'" ;;
    *)           [ -z "$TARGET" ] || die "only one TARGET allowed"; TARGET=$1; shift ;;
  esac
done
[ -n "$TARGET" ] || [ -n "$EXEC" ] || die "give an ssh TARGET or --exec 'CMD' (see --help)"
[ -d "$SRC" ] || die "--path '$SRC' is not a directory"
SRC=$(cd "$SRC" && pwd -P)
MNT=${MNT:-$SRC}
case "$MNT" in /*) ;; *) die "--mount-at must be an absolute path" ;; esac
if [ "$USE_DEFAULT_HIDE" = 1 ]; then HIDE=("${DEFAULT_HIDE[@]}" ${HIDE[@]+"${HIDE[@]}"}); fi

KEY=$(printf '%s|%s|%s' "$TARGET" "$EXEC" "$MNT" | cksum | awk '{print $1}')
LOCAL_STATE="$HOME/.conduit/$KEY"

# --------------------------------------------------------------- transport
# remote ARGV... : run ARGV on the sandbox with stdin/stdout passed through.
remote() {
  if [ -n "$EXEC" ]; then
    eval "$EXEC" '"$@"'
  else
    local q="" a
    for a in "$@"; do q="$q $(printf '%q' "$a")"; done
    # ControlMaster: the many short helper calls reuse one connection.
    ssh -T -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
      -o ControlMaster=auto -o "ControlPath=/tmp/conduit-%C" -o ControlPersist=60 \
      ${SSH_OPTS[@]+"${SSH_OPTS[@]}"} "$TARGET" "$q"
  fi
}
# helper SUBCMD ARGS... : run the sandbox-side helper (installed by `install_helper`).
helper() { remote sh -c 'exec sh "$HOME/.conduit/remote.sh" "$@"' conduit "$@"; }
install_helper() {
  remote_script | remote sh -c 'mkdir -p "$HOME/.conduit" && cat > "$HOME/.conduit/remote.sh"' \
    || die "could not reach the sandbox"
}

find_sftp_server() {
  local c
  for c in "${CONDUIT_SFTP_SERVER:-}" /usr/libexec/sftp-server /usr/lib/openssh/sftp-server \
           /usr/lib/ssh/sftp-server /usr/libexec/openssh/sftp-server /opt/homebrew/libexec/sftp-server; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
  done
  die "couldn't find OpenSSH's sftp-server (set CONDUIT_SFTP_SERVER)"
}

# ----------------------------------------------------------- write-back-new
# Is the (possibly not yet existing) path $1 inside $SRC once symlinks resolve?
inside_src() {
  local p=$1
  while [ ! -d "$p" ]; do p=$(dirname "$p"); done
  p=$(cd "$p" && pwd -P) || return 1
  case "$p/" in "$SRC"/*) return 0 ;; *) return 1 ;; esac
}
writeback_allowed() {
  case "/$1" in
    */.*) return 1 ;;                   # dotfiles/dirs: .ssh, .zshrc, .git/hooks, .config…
    /Library/*) [ "$SRC" = "$HOME" ] && return 1 ;;   # LaunchAgents and friends
  esac
  return 0
}
writeback_once() {
  local tmp rel dst mf="$LOCAL_STATE/created"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/conduit-wb.XXXXXX")
  if helper newfiles "$MNT" 2>/dev/null | tar -xpf - -C "$tmp" 2>/dev/null; then
    (cd "$tmp" && find . -type f) | while IFS= read -r rel; do
      rel=${rel#./}; dst="$SRC/$rel"
      writeback_allowed "$rel" || { info "write-back: skipped $rel (protected path)"; continue; }
      inside_src "$(dirname "$dst")" || { info "write-back: skipped $rel (outside $SRC)"; continue; }
      if [ -e "$dst" ] || [ -L "$dst" ]; then
        if ! grep -qxF "$rel" "$mf" 2>/dev/null || [ -L "$dst" ]; then
          info "write-back: skipped $rel (already exists on the laptop)"; continue
        fi
      fi
      mkdir -p "$(dirname "$dst")" && chmod u+w,go-w,-s "$tmp/$rel" && mv -f "$tmp/$rel" "$dst" || continue
      grep -qxF "$rel" "$mf" 2>/dev/null || echo "$rel" >> "$mf"
      info "write-back: $rel"
    done
  fi
  rm -rf "$tmp"
}
writeback_loop() {
  trap 'exit 0' TERM INT HUP
  while :; do sleep "${CONDUIT_SYNC_INTERVAL:-5}"; writeback_once; done
}

# ---------------------------------------------------------------- commands
cmd_up() {
  local sftp; sftp=$(find_sftp_server)
  [ "$SRC" = "$HOME" ] && info "sharing your whole home folder; use --path to share less"
  case "$MODE$WRITEBACK" in
    ro0)       info "mode: read-only" ;;
    writable0) info "mode: writable on the sandbox (copy-on-write; laptop untouched)" ;;
    writable1) info "mode: writable on the sandbox + new files copied back to $SRC" ;;
  esac

  mkdir -p "$LOCAL_STATE"
  WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/conduit.XXXXXX")
  local fifo="$WORKDIR/pipe"; mkfifo "$fifo"

  # One `conduit up` per sandbox + mount point; two would fight over the mount.
  LOCK="$LOCAL_STATE/lock"
  if ! mkdir "$LOCK" 2>/dev/null; then
    local other; other=$(cat "$LOCK/pid" 2>/dev/null || true)
    if [ -n "$other" ] && kill -0 "$other" 2>/dev/null; then
      rm -rf "$WORKDIR"; die "already running for $MNT (pid $other)"
    fi
    rm -rf "$LOCK"; mkdir "$LOCK"
  fi
  echo $$ > "$LOCK/pid"
  trap 'rm -rf "$WORKDIR" "$LOCK"' EXIT

  info "installing helper on ${TARGET:-sandbox}…"
  install_helper
  helper setup "$MODE" || die "sandbox setup failed (see above)"

  # Each connection runs as its own process group, so stopping kills ssh and
  # sftp-server too, whether we get Ctrl-C, SIGTERM or SIGHUP.
  set -m
  STOP=0 PGID="" WBPID=""
  stop() {
    STOP=1
    [ -z "$WBPID" ] || kill -TERM "$WBPID" 2>/dev/null || true
    # Unmount first, while sshfs is still alive: some sandboxes (e.g. sysbox) can't
    # unmount a FUSE mount whose process has already died.
    [ -z "$PGID" ] || { info "stopping; unmounting on the sandbox…"; helper down "$MNT" >/dev/null 2>&1 || true; }
    [ -z "$PGID" ] || kill -TERM -- "-$PGID" 2>/dev/null || true
  }
  trap stop INT TERM HUP
  if [ "$WRITEBACK" = 1 ]; then writeback_loop & WBPID=$!; fi

  local tries=0 started rc
  while :; do
    started=$(date +%s)
    # sftp-server -R  <->  ssh  <->  sshfs -o passive (on the sandbox)
    (
      "$sftp" -R -d "$SRC" < "$fifo" | helper mount "$MODE" "$SRC" "$MNT" \
          ${HIDE[@]+"${HIDE[@]}"} > "$fifo"
      exit "${PIPESTATUS[1]}"
    ) &
    PGID=$!
    set +e
    wait "$PGID"; rc=$?
    while kill -0 "$PGID" 2>/dev/null; do wait "$PGID"; rc=$?; done  # wait returns early on signals
    set -e
    PGID=""
    [ "$STOP" = 1 ] && break
    [ "$rc" = 3 ] && { stop; die "sandbox refused the mount (see message above)"; }
    if [ $(( $(date +%s) - started )) -lt 15 ]; then tries=$((tries + 1)); else tries=1; fi
    [ "$tries" -ge 5 ] && { stop; die "connection keeps failing; giving up"; }
    info "connection lost (exit $rc); reconnecting in $((tries * 2))s…  (Ctrl-C to quit)"
    sleep $((tries * 2))
  done
  info "stopped"
}

cmd_status() { install_helper; helper status; }
cmd_down()   { install_helper; helper down "$MNT"; }
cmd_diff()   { install_helper; helper diff "$MNT"; }

cmd_pull() {
  install_helper
  mkdir -p "$DEST"
  helper pull "$MNT" | tar -xpf - -C "$DEST"
  info "copied sandbox-side changes into $DEST (your shared folder was not touched)"
}

# ------------------------------------------------- sandbox-side helper (POSIX sh)
remote_script() {
cat <<'REMOTE'
#!/bin/sh
# conduit sandbox helper — installed and driven by `conduit` on the laptop.
set -u
log() { echo "[conduit@$(hostname 2>/dev/null || echo sandbox)] $*" >&2; }
fatal() { log "$*"; exit 3; }

SUDO=""
if [ "$(id -u)" != 0 ]; then
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then SUDO="sudo -n"; fi
fi
ROOTISH=0; { [ "$(id -u)" = 0 ] || [ -n "$SUDO" ]; } && ROOTISH=1
U=$(id -u); G=$(id -g)

state_dir() { # short, unique, filesystem-safe name per mount point
  b=$(basename "$1" | tr -d '\n' | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40)
  echo "$HOME/.conduit/state/$b-$(printf '%s' "$1" | cksum | awk '{print $1}')"
}
# Read /proc/mounts rather than stat()ing: a dead FUSE mount makes stat fail.
is_mounted() { awk -v m="$1" '{gsub(/\\040/," ",$2)} $2==m{f=1} END{exit !f}' /proc/mounts; }
unmount() {
  n=0
  while is_mounted "$1" && [ $n -lt 5 ]; do
    # -c: don't canonicalize (stat) the path; that fails on a dead FUSE mount
    $SUDO umount -l -c "$1" 2>/dev/null || $SUDO umount -l "$1" 2>/dev/null \
      || $SUDO fusermount3 -uz "$1" 2>/dev/null || $SUDO fusermount -uz "$1" 2>/dev/null
    n=$((n + 1))
  done
}

pkg_install() {
  [ "$ROOTISH" = 1 ] || return 1
  if command -v apt-get >/dev/null; then
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq >&2 &&
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" >/dev/null
  elif command -v dnf >/dev/null; then $SUDO dnf install -y -q "$@" >&2
  elif command -v yum >/dev/null; then $SUDO yum install -y -q "$@" >&2
  elif command -v apk >/dev/null; then $SUDO apk add -q "$@" >&2
  elif command -v pacman >/dev/null; then $SUDO pacman -Sy --noconfirm "$@" >&2
  elif command -v zypper >/dev/null; then $SUDO zypper -q install -y "$@" >&2
  else return 1; fi
}

cmd_setup() {
  if ! command -v sshfs >/dev/null 2>&1; then
    log "installing sshfs…"
    if command -v dnf >/dev/null || command -v yum >/dev/null; then pkg_install fuse-sshfs
    else pkg_install sshfs; fi || fatal "sshfs is missing and couldn't be installed (need root or passwordless sudo)"
  fi
  [ -e /dev/fuse ] || fatal "no /dev/fuse on this sandbox. FUSE must be allowed (docker: --device /dev/fuse --cap-add SYS_ADMIN)"
  if ! command -v fuse-overlayfs >/dev/null 2>&1; then
    pkg_install fuse-overlayfs >/dev/null 2>&1 || true   # fallback only; best effort
    [ "$ROOTISH" = 1 ] || command -v fuse-overlayfs >/dev/null 2>&1 \
      || fatal "without root, conduit needs fuse-overlayfs preinstalled"
  fi
  log "ready (sshfs $(sshfs --version 2>&1 | awk '/SSHFS version/{print $3; exit}'), root=$ROOTISH)"
}

make_whiteout() { # $1 = upper dir, $2 = relative path
  d=$(dirname "$1/$2"); b=$(basename "$2")
  mkdir -p "$d"
  { [ -e "$1/$2" ] || [ -L "$1/$2" ]; } && return 0
  if [ "$ROOTISH" = 1 ]; then $SUDO mknod "$1/$2" c 0 0 2>/dev/null && return 0; fi
  : > "$d/.wh.$b"   # fuse-overlayfs whiteout format
}

cmd_mount() {
  mode=$1 src=$2 mnt=$3; shift 3
  # fd 3/4 = the SFTP byte stream from the laptop. Keep stdout clean of chatter.
  exec 3<&0 4>&1 1>&2

  st=$(state_dir "$mnt")
  # take over from a previous connection (dropped, or stale)
  mkdir -p "$st/upper" "$st/work" || fatal "can't create state dir $st"
  unmount "$mnt"
  [ -f "$st/lowerdir" ] && unmount "$(cat "$st/lowerdir")"
  [ -f "$st/pid" ] && $SUDO kill "$(cat "$st/pid")" 2>/dev/null
  # A fresh lower path per connection: if a dropped connection left a dead FUSE
  # mount we can't remove, it can't block this one. Tidy up old empty ones.
  for d in "$st"/lower.*; do [ -d "$d" ] && ! is_mounted "$d" && rmdir "$d" 2>/dev/null; done
  lower="$st/lower.$$"
  mkdir -p "$lower" || fatal "can't create $lower"
  echo "$lower" > "$st/lowerdir"

  if [ ! -d "$mnt" ]; then
    $SUDO mkdir -p "$mnt" || fatal "can't create $mnt"
    $SUDO chown "$U:$G" "$mnt" 2>/dev/null || true
  fi

  passive=passive
  sshfs -h 2>&1 | grep -q passive || passive=slave
  opts="$passive,ro,uid=$U,gid=$G"
  [ "$ROOTISH" = 1 ] && opts="$opts,allow_other"

  $SUDO sshfs -f -o "$opts" "laptop:$src" "$lower" <&3 >&4 &
  pid=$!
  exec 3<&- 4>&-
  echo "$pid" > "$st/pid"

  i=0
  until is_mounted "$lower"; do
    kill -0 "$pid" 2>/dev/null || { wait "$pid"; log "sshfs exited before mounting"; exit 1; }
    i=$((i + 1)); [ $i -gt 150 ] && { kill "$pid"; fatal "timed out waiting for sshfs"; }
    sleep 0.2
  done

  cleanup() { trap - EXIT INT TERM HUP; unmount "$mnt"; unmount "$lower"; $SUDO kill "$pid" 2>/dev/null; rmdir "$lower" 2>/dev/null; }
  trap cleanup EXIT INT TERM HUP

  rwflag=""; [ "$mode" = ro ] && rwflag="ro,"
  # Hide markers (whiteouts), only for paths that actually exist on the laptop.
  hide() {
    : > "$st/hidden"
    for h in "$@"; do
      if [ -e "$lower/$h" ] || [ -L "$lower/$h" ]; then make_whiteout "$upper" "$h"; echo "$h" >> "$st/hidden"; fi
    done
  }
  kovl() { $SUDO mount -t overlay conduit -o "${rwflag}lowerdir=$lower,upperdir=$upper,workdir=$work" "$mnt" 2>/dev/null; }
  how=""
  if [ "$ROOTISH" = 1 ]; then
    # 1) kernel overlayfs, writable layer on the sandbox's disk (live + persistent)
    upper="$st/upper"; work="$st/work"; hide "$@"
    if kovl; then how="overlayfs"
    else
      # 2) the disk can't host an overlay upper (e.g. the container's rootfs is itself
      #    overlay): give the writable layer its own tmpfs. Survives reconnects, not reboots.
      rw="$st/rw"; mkdir -p "$rw"
      is_mounted "$rw" || $SUDO mount -t tmpfs -o "size=${CONDUIT_TMPFS_SIZE:-4g},mode=755" conduit-rw "$rw" 2>/dev/null
      if is_mounted "$rw"; then
        upper="$rw/upper"; work="$rw/work"; $SUDO mkdir -p "$upper" "$work"
        $SUDO chown "$U:$G" "$upper"; hide "$@"
        kovl && how="overlayfs (writable layer in RAM)"
      fi
    fi
  fi
  if [ -z "$how" ]; then
    # 3) fuse-overlayfs: works unprivileged, but caches the laptop side aggressively
    upper="$st/upper"; work="$st/work"; hide "$@"
    if command -v fuse-overlayfs >/dev/null 2>&1 && \
       $SUDO fuse-overlayfs -o "${rwflag}lowerdir=$lower,upperdir=$upper,workdir=$work$([ "$ROOTISH" = 1 ] && echo ,allow_other)" "$mnt" 2>/dev/null; then
      how="fuse-overlayfs"
      log "warning: with fuse-overlayfs, edits made on the laptop may not show up until remount"
    else
      fatal "couldn't mount an overlay on $mnt (kernel overlayfs refused and fuse-overlayfs unavailable)"
    fi
  fi
  echo "$upper" > "$st/upperdir"
  if [ "$mode" = ro ]; then
    log "mirroring laptop:$src -> $mnt (read-only, via $how)"
  else
    log "mirroring laptop:$src -> $mnt (writable on the sandbox via $how; changes in $upper)"
  fi
  wait "$pid"
  log "connection to laptop closed"
}

cmd_down() {
  st=$(state_dir "$1")
  unmount "$1"                                   # overlay first, then the laptop mount,
  [ -f "$st/lowerdir" ] && unmount "$(cat "$st/lowerdir")"   # both while sshfs is alive
  [ -f "$st/pid" ] && $SUDO kill "$(cat "$st/pid")" 2>/dev/null
  if is_mounted "$1"; then log "couldn't unmount $1"; exit 1; fi
  lw=$(cat "$st/lowerdir" 2>/dev/null)
  [ -n "$lw" ] && is_mounted "$lw" && log "note: this sandbox can't unmount FUSE mounts (sysbox?); a stale internal mount remains at $lw until restart"
  log "unmounted $1 (sandbox-side changes kept)"
}

cmd_status() {
  out=$(awk '$1=="conduit" || ($1 ~ /^laptop:/ && $2 !~ /\/\.conduit\/state\//) \
             {gsub(/\\040/," ",$2); print $2}' /proc/mounts)
  if [ -n "$out" ]; then echo "$out"; else log "nothing mounted"; fi
}

upper_of() {
  up=$(cat "$(state_dir "$1")/upperdir" 2>/dev/null) && [ -d "$up" ] || fatal "no conduit state for $1"
  echo "$up"
}

cmd_diff() {
  mnt=$1 st=$(state_dir "$1"); up=$(upper_of "$1") || exit 3; lw=$(cat "$st/lowerdir")
  cd "$up" || exit 1
  find . -mindepth 1 \( -type f -o -type l -o -type c \) | sort | while IFS= read -r p; do
    rel=${p#./}; base=$(basename "$rel")
    case "$base" in .wh..wh.*) continue ;; .wh.*) rel="$(dirname "$rel")/${base#.wh.}"; rel=${rel#./}; kind=D ;; *)
      if [ -c "$p" ]; then kind=D
      elif grep -qxF "$rel" "$st/created" 2>/dev/null; then kind=A
      elif [ -e "$lw/$rel" ] || [ -L "$lw/$rel" ]; then kind=M
      else kind=A; fi ;;
    esac
    grep -qxF "$rel" "$st/hidden" 2>/dev/null && continue
    printf '%s %s/%s\n' "$kind" "$mnt" "$rel"
  done
}

cmd_pull() {
  up=$(upper_of "$1") || exit 3
  cd "$up" || exit 1
  find . -mindepth 1 \( -type f -o -type l \) ! -name '.wh.*' | tar -cf - -T - 2>/dev/null
}

# Files the sandbox created (not present on the laptop when first seen),
# changed since the last call, as a tar stream. Drives --write-back-new.
cmd_newfiles() {
  st=$(state_dir "$1"); up=$(upper_of "$1") || exit 3; lw=$(cat "$st/lowerdir")
  touch "$st/stamp.next"
  cd "$up" || exit 1
  { if [ -f "$st/stamp" ]; then find . -type f -newer "$st/stamp"; else find . -type f; fi; } |
  while IFS= read -r p; do
    rel=${p#./}
    case "$(basename "$rel")" in .wh.*) continue ;; esac
    if grep -qxF "$rel" "$st/created" 2>/dev/null; then echo "$p"
    elif [ ! -e "$lw/$rel" ] && [ ! -L "$lw/$rel" ]; then echo "$rel" >> "$st/created"; echo "$p"
    fi
  done > "$st/batch"
  tar -cf - -T "$st/batch" 2>/dev/null
  mv "$st/stamp.next" "$st/stamp"
}

sub=$1; shift
case "$sub" in
  setup) cmd_setup "$@" ;; mount) cmd_mount "$@" ;; down) cmd_down "$@" ;;
  status) cmd_status ;; diff) cmd_diff "$@" ;; pull) cmd_pull "$@" ;; newfiles) cmd_newfiles "$@" ;;
  *) fatal "unknown helper command $sub" ;;
esac
REMOTE
}

"cmd_$CMD"
